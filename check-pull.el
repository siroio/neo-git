;;; check-pull.el --- Pull with local changes -*- lexical-binding: t; -*-
(load (expand-file-name "neo-git.el" (file-name-directory load-file-name)) nil t)
(require 'ert)

(defun neo-git-pull-check-git (directory &rest arguments)
  (with-temp-buffer
    (let ((default-directory directory))
      (let ((status (apply #'process-file (neo-git--executable) nil t nil arguments)))
        (ert-info ((format "Git %S: %s" arguments (buffer-string)))
          (should (zerop status))))
      (string-trim (buffer-string)))))

(defun neo-git-pull-check-wait ()
  (let ((deadline (+ (float-time) 15)))
    (while (and (or neo-git--mutation neo-git--status-updating
                    neo-git--refresh-process neo-git--refresh-timer)
                (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (should-not neo-git--mutation)
    (should-not neo-git--status-updating)
    (should-not neo-git--refresh-process)
    (should-not neo-git--refresh-timer)))

(defmacro neo-git-pull-check-repository (&rest body)
  (declare (indent 0))
  `(let* ((base (file-name-as-directory (make-temp-file "neo-git-pull-" t)))
          (root (expand-file-name "work/" base))
          (remote (expand-file-name "remote/" base))
          (default-directory root)
          (process-environment (copy-sequence process-environment))
          (owner (generate-new-buffer " *pull-check*")))
     (setenv "GIT_CONFIG_GLOBAL" (expand-file-name "empty-config" base))
     (setenv "GIT_CONFIG_NOSYSTEM" "1")
     (unwind-protect
         (progn
           (make-directory root)
           (neo-git-pull-check-git root "init" "-qb" "main")
           (neo-git-pull-check-git root "config" "user.name" "Pull Check")
           (neo-git-pull-check-git root "config" "user.email" "check@example.invalid")
           (with-temp-file "file.txt"
             (insert "base\n")
             (dotimes (i 20) (insert (format "context %d\n" i)))
             (insert "end\n"))
           (with-temp-file "staged.txt" (insert "base\n"))
           (neo-git-pull-check-git root "add" ".")
           (neo-git-pull-check-git root "commit" "-qm" "base")
           (neo-git-pull-check-git base "clone" "-q" root remote)
           (neo-git-pull-check-git remote "config" "user.name" "Pull Check")
           (neo-git-pull-check-git remote "config" "user.email" "check@example.invalid")
           (neo-git-pull-check-git root "remote" "add" "origin" remote)
           (neo-git-pull-check-git root "config" "branch.main.remote" "origin")
           (neo-git-pull-check-git root "config" "branch.main.merge" "refs/heads/main")
           (with-current-buffer owner
             (neo-git-mode)
             (setq neo-git-root root)
             ,@body))
       (when (buffer-live-p owner)
         (with-current-buffer owner (neo-git-pull-check-wait)))
       (dolist (buffer (buffer-list))
         (with-current-buffer buffer
           (when (and buffer-file-name (file-in-directory-p buffer-file-name base))
             (set-buffer-modified-p nil)
             (kill-buffer buffer))))
       (when (buffer-live-p owner) (kill-buffer owner))
       (delete-directory base t))))

(defun neo-git-pull-check-incoming (remote)
  (with-temp-buffer
    (insert-file-contents (expand-file-name "file.txt" remote))
    (goto-char (point-min))
    (delete-region (point) (line-end-position))
    (insert "incoming")
    (write-region (point-min) (point-max) (expand-file-name "file.txt" remote) nil 'silent))
  (neo-git-pull-check-git remote "commit" "-qam" "incoming"))

(ert-deftest neo-git-pull-keeps-local-edits-and-reloads-buffers ()
  (dolist (rebase '("false" "true"))
    (neo-git-pull-check-repository
      (neo-git-pull-check-git root "config" "pull.rebase" rebase)
      (neo-git-pull-check-incoming remote)
      (with-temp-file "committed.txt" (insert "local commit\n"))
      (neo-git-pull-check-git root "add" "committed.txt")
      (neo-git-pull-check-git root "commit" "-qm" "local commit")
      (let ((file (find-file-noselect "file.txt")))
        (with-current-buffer file
          (goto-char (point-max))
          (insert "local edit\n")
          (save-buffer))
        (with-temp-file "staged.txt" (insert "staged edit\n"))
        (neo-git-pull-check-git root "add" "staged.txt")
        (with-temp-file "untracked.txt" (insert "untracked edit\n"))
        (neo-git-pull)
        (neo-git-pull-check-wait)
        (should-not neo-git--last-error)
        (neo-git-pull-check-git root "merge-base" "--is-ancestor" "origin/main" "HEAD")
        (should (equal (neo-git-pull-check-git root "rev-list" "--count" "HEAD")
                       (if (equal rebase "true") "3" "4")))
        (with-current-buffer file
          (should (string-prefix-p "incoming\n" (buffer-string)))
          (should (string-suffix-p "local edit\n" (buffer-string))))
        (should (equal (neo-git-pull-check-git root "diff" "--name-only")
                       "file.txt\nstaged.txt"))
        (should (string-empty-p (neo-git-pull-check-git root "diff" "--cached")))
        (should (equal (neo-git-pull-check-git root "stash" "list") ""))
        (should (equal (with-temp-buffer (insert-file-contents "staged.txt") (buffer-string))
                       "staged edit\n"))
        (should (equal (with-temp-buffer (insert-file-contents "untracked.txt") (buffer-string))
                       "untracked edit\n"))))))

(ert-deftest neo-git-pull-restoration-conflict-is-visible-and-backed-up ()
  (neo-git-pull-check-repository
    (neo-git-pull-check-git root "config" "pull.rebase" "false")
    (neo-git-pull-check-incoming remote)
    (with-temp-file "file.txt" (insert "local replacement\n"))
    (neo-git-pull)
    (neo-git-pull-check-wait)
    (should (seq-some (lambda (entry) (eq (plist-get entry :kind) 'conflict)) neo-git-entries))
    (should (string-match-p "local replacement"
                           (neo-git-pull-check-git root "show" "stash@{0}:file.txt")))
    (should (equal (neo-git-pull-check-git root "log" "-1" "--format=%s") "incoming"))))

(ert-deftest neo-git-pull-refuses-unsaved-editing ()
  (neo-git-pull-check-repository
    (let ((file (find-file-noselect "file.txt")))
      (with-current-buffer file (insert "unsaved edit\n"))
      (should-error (neo-git-pull) :type 'user-error)
      (should-not neo-git--mutation)
      (should (buffer-modified-p file)))))

(ert-deftest neo-git-pull-protects-untracked-collision ()
  (neo-git-pull-check-repository
    (with-temp-file (expand-file-name "collision.txt" remote) (insert "remote data\n"))
    (neo-git-pull-check-git remote "add" "collision.txt")
    (neo-git-pull-check-git remote "commit" "-qm" "collision")
    (with-temp-file "collision.txt" (insert "local data\n"))
    (neo-git-pull)
    (neo-git-pull-check-wait)
    (should neo-git--last-error)
    (should (equal (with-temp-buffer (insert-file-contents "collision.txt") (buffer-string))
                   "local data\n"))
    (should (seq-some (lambda (entry) (equal (plist-get entry :path) "collision.txt"))
                      neo-git-entries))
    (should (equal (neo-git-pull-check-git root "log" "-1" "--format=%s") "base"))))

(ert-deftest neo-git-pull-integration-conflict-can-abort-and-restore-edits ()
  (dolist (rebase '("false" "true"))
    (neo-git-pull-check-repository
      (neo-git-pull-check-git root "config" "pull.rebase" rebase)
      (neo-git-pull-check-incoming remote)
      (with-temp-file "file.txt" (insert "local commit\n"))
      (neo-git-pull-check-git root "commit" "-qam" "local commit")
      (with-temp-file "staged.txt" (insert "uncommitted edit\n"))
      (neo-git-pull)
      (neo-git-pull-check-wait)
      (should neo-git--last-error)
      (should (equal (neo-git--in-progress-p) (if (equal rebase "true") "rebase" "merge")))
      (should (seq-some (lambda (entry) (eq (plist-get entry :kind) 'conflict)) neo-git-entries))
      (cl-letf (((symbol-function 'read-char-choice) (lambda (&rest _) ?a))
                ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
        (neo-git-continue))
      (neo-git-pull-check-wait)
      (should-not neo-git--last-error)
      (should-not (neo-git--in-progress-p))
      (should (equal (neo-git-pull-check-git root "log" "-1" "--format=%s") "local commit"))
      (should (equal (with-temp-buffer (insert-file-contents "staged.txt") (buffer-string))
                     "uncommitted edit\n")))))

(ert-run-tests-batch-and-exit)
