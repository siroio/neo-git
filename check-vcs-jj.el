;;; check-vcs-jj.el --- Jujutsu checks -*- lexical-binding: t; coding: utf-8; -*-
(require 'check-vcs-test-helper)
(require 'neo-vcs-jj nil t)

(ert-deftest neo-vcs-jj-structured-paths-and-conflicts ()
  (should (fboundp 'neo-vcs-jj--status))
  (let ((entries (plist-get
                  (neo-vcs-jj--status
                   '("{\"path\":\"space [x]\\n名.txt\",\"status\":\"renamed\",\"source\":\"old.txt\",\"conflict\":false}\n{\"path\":\"conflict.txt\",\"status\":\"modified\",\"source\":\"conflict.txt\",\"conflict\":true}\n"
                     "{\"revision\":\"qqqq\",\"description\":\"change description\"}")) :entries)))
    (should (equal (plist-get (car entries) :path) "space [x]\n名.txt"))
    (should (equal (plist-get (car entries) :old-path) "old.txt"))
    (should (eq (plist-get (cadr entries) :status) 'conflict))))

(ert-deftest neo-vcs-jj-filesets-are-literal ()
  (should (fboundp 'neo-vcs-jj--filesets))
  (should (equal (neo-vcs-jj--filesets (list :root default-directory)
                                      '((:path "all() | glob:*.el")))
                 '("root-file:\"all() | glob:*.el\""))))

(ert-deftest neo-vcs-jj-delayed-description-pins-the-original-change ()
  (let* ((state (neo-vcs-jj--status '("" "{\"revision\":\"qqqq\",\"description\":\"original\"}")))
         (request (neo-vcs-jj-request (list :root default-directory) 'describe nil
                                      '(:message "message" :revision "qqqq")))
         (args (plist-get (car (plist-get request :commands)) :args)))
    (should (equal (plist-get state :revision) "qqqq"))
    (should (equal (cadr (member "--revision" args)) "qqqq"))))

(ert-deftest neo-vcs-jj-real-file-workflow ()
  (should (fboundp 'neo-vcs-jj-request))
  (skip-unless (executable-find "jj"))
  (let* ((root (file-name-as-directory (make-temp-file "neo-vcs-jj-" t)))
         (default-directory root)
         (process-environment (copy-sequence process-environment))
         (config (expand-file-name "config.toml" root))
         (repo (expand-file-name "repo" root)))
    (unwind-protect
        (progn
          (with-temp-file config
            (insert "[user]\nname = 'Neo VCS Test'\nemail = 'neo-vcs@example.invalid'\n"))
          (setenv "JJ_CONFIG" config)
          (neo-vcs-test-cli "jj" "git" "init" repo)
          (let* ((context (neo-vcs-test-request (list :backend 'jj :root repo) 'root))
                 (default-directory (plist-get context :root)))
            (with-temp-file "日本語 [literal] @.txt" (insert "first\n"))
            (with-temp-file "other.txt" (insert "other\n"))
            (let* ((state (neo-vcs-test-request context 'status))
                   (entry (cl-find "日本語 [literal] @.txt" (plist-get state :entries)
                                   :key (lambda (e) (plist-get e :path)) :test #'equal)))
              (should entry)
              (should (string-match-p "+first" (neo-vcs-test-request context 'diff entry)))
              (neo-vcs-test-request context 'describe nil '(:message "first change") t)
              (should (cl-find "first change" (neo-vcs-test-request context 'history)
                               :key (lambda (r) (plist-get r :subject)) :test #'equal))
              (neo-vcs-test-request context 'split (list entry) '(:message "selected file") t)
              (let ((state (neo-vcs-test-request context 'status)))
                (should (equal (mapcar (lambda (e) (plist-get e :path)) (plist-get state :entries))
                               '("other.txt"))))
              (neo-vcs-test-request context 'squash '((:path "other.txt")) '(:message "combined") t)
              (should-not (plist-get (neo-vcs-test-request context 'status) :entries))
              (with-temp-file "日本語 [literal] @.txt" (insert "changed\n"))
              (with-temp-file "other.txt" (insert "unrelated\n"))
              (neo-vcs-test-request context 'restore (list entry) nil t)
              (should (equal (with-temp-buffer (insert-file-contents "日本語 [literal] @.txt") (buffer-string))
                             "first\n"))
              (should (equal (with-temp-buffer (insert-file-contents "other.txt") (buffer-string)) "unrelated\n"))
              (let ((history (neo-vcs-test-request context 'history)))
                (should (stringp (neo-vcs-test-request context 'show (car history)))))
            (should (eq (neo-vcs-detect default-directory) 'jj))
            (neo-vcs-test-open context))))
      (delete-directory root t))))

(ert-deftest neo-vcs-jj-real-changes-and-local-remote ()
  (skip-unless (and (executable-find "jj") (executable-find "git")))
  (let* ((root (file-name-as-directory (make-temp-file "neo-vcs-jj-remote-" t)))
         (default-directory root)
         (process-environment (copy-sequence process-environment))
         (config (expand-file-name "config.toml" root))
         (remote (expand-file-name "remote.git" root))
         (repo (expand-file-name "repo" root)))
    (unwind-protect
        (progn
          (with-temp-file config
            (insert "[user]\nname = 'Neo VCS Test'\nemail = 'neo-vcs@example.invalid'\n"))
          (setenv "JJ_CONFIG" config)
          (neo-vcs-test-cli "git" "init" "--bare" remote)
          (neo-vcs-test-cli "jj" "git" "init" repo)
          (let* ((context (neo-vcs-test-request (list :backend 'jj :root repo) 'root))
                 (default-directory (plist-get context :root)))
            (neo-vcs-test-cli "jj" "git" "remote" "add" "origin" remote)
            (with-temp-file "file.txt" (insert "first\n"))
            (neo-vcs-test-request context 'describe nil '(:message "Seed") t)
            (neo-vcs-test-request context 'bookmark nil '(:name "main") t)
            ;; Establish tracking exactly as an existing jj user would.
            (neo-vcs-test-cli "jj" "git" "push" "--bookmark" "main")
            (neo-vcs-test-request context 'new nil '(:revision "main") t)
            (with-temp-file "file.txt" (insert "second\n"))
            (neo-vcs-test-request context 'describe nil '(:message "Second") t)
            (neo-vcs-test-request context 'bookmark nil '(:name "main") t)
            (neo-vcs-test-request context 'push nil nil t)
            (should (equal (string-trim (neo-vcs-test-cli "git" "--git-dir" remote "show" "main:file.txt"))
                           "second"))
            (neo-vcs-test-request context 'new nil '(:revision "@") t)
            (with-temp-file "file.txt" (insert "third\n"))
            (neo-vcs-test-request context 'describe nil '(:message "Third") t)
            (neo-vcs-test-request context 'new nil '(:revision "@") t)
            (neo-vcs-test-request context 'edit nil '(:revision "@-") t)
            (should (string-match-p "Third" (plist-get (neo-vcs-test-request context 'status) :label)))
            (neo-vcs-test-request context 'fetch nil nil t)))
      (delete-directory root t))))

(provide 'check-vcs-jj)
