;;; check-vcs-hg.el --- Mercurial backend checks -*- lexical-binding: t; coding: utf-8; -*-
(require 'check-vcs-test-helper)
(require 'neo-vcs-hg)

(defconst neo-vcs-hg-test-context
  (list :backend 'hg :root (file-name-as-directory temporary-file-directory)))

(ert-deftest neo-vcs-hg-status-preserves-copies-and-unresolved-files ()
  (cl-letf (((symbol-function 'neo-vcs-hg--file-coding) (lambda () 'utf-8-unix)))
   (let* ((request (neo-vcs--request neo-vcs-hg-test-context 'status))
         (state (funcall (plist-get request :parse)
                         '("{\"path_hex\":\"2de5908de5898d205b615d40312e747874\",\"source_hex\":\"6f6c64206e616d652e747874\",\"status\":\"A\"}\n{\"path_hex\":\"6c696e6520627265616b\",\"source_hex\":\"\",\"status\":\"M\"}\n"
                           "{\"mergestatus\":\"U\",\"path_hex\":\"6c696e6520627265616b\"}\n{\"mergestatus\":\"R\",\"path_hex\":\"68616e646c65642e747874\"}\n"
                           "default\n")))
         (entries (plist-get state :entries)))
    (should (equal (mapcar (lambda (entry)
                             (list (plist-get entry :path) (plist-get entry :status)
                                   (plist-get entry :old-path)))
                           entries)
                   '(("-名前 [a]@1.txt" added "old name.txt")
                     ("line break" conflict nil))))
    (should-error (funcall (plist-get request :parse)
                           '("{\"path_hex\":\"2e2e2f657363617065\",\"source_hex\":\"\",\"status\":\"M\"}\n"
                             "" "default\n"))))))

(ert-deftest neo-vcs-hg-history-preserves-full-identifier ()
  (let* ((parser (plist-get (neo-vcs--request neo-vcs-hg-test-context 'history) :parse))
         (history (funcall parser
                           '("[{\"bookmarks\":[],\"branch\":\"default\",\"date\":[0,-32400],\"desc\":\"最初の変更\\nDetails\",\"node\":\"ddc4058378e4b104efc0567a05c7544f7c0a04aa\",\"parents\":[\"0000000000000000000000000000000000000000\"],\"phase\":\"draft\",\"rev\":0,\"tags\":[\"tip\"],\"user\":\"Test User\"}]"))))
    (should-not (funcall parser '("[]")))
    (should (equal (plist-get (car history) :id) "ddc4058378e4b104efc0567a05c7544f7c0a04aa"))
    (should (equal (plist-get (car history) :subject) "最初の変更"))
    (should (equal (plist-get (car history) :author) "Test User"))))

(ert-deftest neo-vcs-hg-file-actions-never-widen-selection ()
  (dolist (action '(add remove revert commit))
    (should-error (neo-vcs--request neo-vcs-hg-test-context action nil '(:message "selected"))
                  :type 'user-error)
    (let* ((request (neo-vcs--request neo-vcs-hg-test-context action
                                      '((:path "-名前 [a]@1.txt"))
                                      '(:message "--looks-like-an-option")))
           (args (plist-get (car (plist-get request :commands)) :args)))
      (should (equal (last args 2) '("--" "filepath:-名前 [a]@1.txt")))))
  (let* ((request (neo-vcs--request neo-vcs-hg-test-context 'commit-merge nil
                                    '(:message "merge commit")))
         (check (plist-get (car (plist-get request :commands)) :check)))
    (should (functionp check))
    (should-error (funcall check "[]"))))

(ert-deftest neo-vcs-hg-real-cli-workflow ()
  (let ((hg (or (getenv "NEO_VCS_TEST_HG") (executable-find "hg"))))
    (skip-unless (and hg (file-executable-p hg)))
    (let* ((sandbox (make-temp-file "neo-vcs-hg-" t))
           (origin (expand-file-name "origin" sandbox))
           (repo (file-name-as-directory (expand-file-name "checkout" sandbox)))
           (hgrc (expand-file-name "hgrc" sandbox))
           (process-environment (copy-sequence process-environment))
           (backend (neo-vcs--backend 'hg))
           (neo-vcs--backends (cons (cons 'hg (plist-put (copy-sequence backend) :program hg))
                                   neo-vcs--backends))
           (name "-名前 [glob]@42.txt")
           (sibling "unselected.txt")
           (chosen (list (list :path name)))
           (other (list (list :path sibling))))
      (unwind-protect
          (progn
            (write-region "[ui]\nusername = Neo VCS Test <test@example.invalid>\n" nil hgrc nil 'silent)
            (setenv "HGRCPATH" hgrc)
            (setenv "HGPLAIN" "1")
            (setenv "HGENCODING" nil)
            (neo-vcs-test-cli hg "init" origin)
            (neo-vcs-test-cli hg "clone" origin repo)
            (make-directory (expand-file-name "subdir" repo))
            (let* ((initial (list :backend 'hg :root (expand-file-name "subdir/" repo)))
                   (context (neo-vcs-test-request initial 'root)))
              (should (file-equal-p (plist-get context :root) repo))
              (should-not (neo-vcs-test-request context 'history))
              (let ((coding-system-for-write 'utf-8-unix))
                (write-region "元の内容\n" nil (expand-file-name name repo) nil 'silent))
              (write-region "other\n" nil (expand-file-name sibling repo) nil 'silent)
              (neo-vcs-test-request context 'add (append chosen other) nil t)
              (neo-vcs-test-request context 'commit chosen '(:message "最初の変更\n\nDetails") t)
              (let* ((initial-revision (car (neo-vcs-test-request context 'history)))
                     (initial-id (plist-get initial-revision :id))
                     (entries (plist-get (neo-vcs-test-request context 'status) :entries)))
                (should (equal (mapcar (lambda (entry) (plist-get entry :path)) entries)
                               (list sibling)))
                (should (equal (plist-get initial-revision :subject) "最初の変更"))
                (let ((patch (neo-vcs-test-request context 'show initial-revision)))
                  (should (string-search (concat "+++ b/" name) patch))
                  (should (string-search "+元の内容" patch)))
                (neo-vcs-test-open context)
                (neo-vcs-test-request context 'commit other '(:message "Second selected file") t)
                (neo-vcs-test-request context 'push nil nil t)
                (should-error (neo-vcs-test-request context 'push nil nil t) :type 'ert-test-failed)
                (neo-vcs-test-request context 'pull nil nil t)
                (neo-vcs-test-request context 'update nil (list :revision initial-id) t)
                (should-not (file-exists-p (expand-file-name sibling repo)))
                (neo-vcs-test-request context 'bookmark nil '(:name "--feature") t)
                (let ((coding-system-for-write 'utf-8-unix))
                  (write-region "++ 新規\n" nil (expand-file-name name repo) nil 'silent))
                (let ((patch (neo-vcs-test-request context 'diff (car chosen))))
                  (should (string-search (concat "--- a/" name) patch))
                  (should (string-search "\n+++ 新規\n" patch)))
                (neo-vcs-test-request context 'commit chosen '(:message "Feature head") t)
                (let ((merge-id (plist-get (cadr (neo-vcs-test-request context 'history)) :id)))
                  (neo-vcs-test-request context 'merge nil (list :revision merge-id) t)
                  (neo-vcs-test-request context 'commit-merge nil '(:message "Merge heads") t))
                (should (equal (plist-get (car (neo-vcs-test-request context 'history)) :subject)
                               "Merge heads"))
                (should (file-exists-p (expand-file-name sibling repo)))
                (write-region "temporary\n" nil (expand-file-name name repo) nil 'silent)
                (neo-vcs-test-request context 'revert chosen nil t)
                (should (equal "" (neo-vcs-test-request context 'diff (car chosen))))
                (neo-vcs-test-request context 'remove chosen nil t)
                (should-not (file-exists-p (expand-file-name name repo)))
                (should (eq (plist-get (cl-find name (plist-get (neo-vcs-test-request context 'status) :entries)
                                               :key (lambda (entry) (plist-get entry :path)) :test #'equal)
                                       :status)
                            'deleted)))))
        (when (file-in-directory-p sandbox temporary-file-directory)
          (delete-directory sandbox t))))))

(ert-deftest neo-vcs-hg-push-surfaces-failed-git-subrepository ()
  (let ((hg (or (getenv "NEO_VCS_TEST_HG") (executable-find "hg")))
        (git (executable-find "git")))
    (skip-unless (and git hg (file-executable-p hg)))
    (let* ((sandbox (make-temp-file "neo-vcs-hg-subrepo-" t))
           (hgrc (expand-file-name "hgrc" sandbox))
           (remote (file-name-as-directory (expand-file-name "remote" sandbox)))
           (repo (file-name-as-directory (expand-file-name "checkout" sandbox)))
           (child (file-name-as-directory (expand-file-name "git-child" repo)))
           (origin (expand-file-name "git-origin" sandbox))
           (backend (neo-vcs--backend 'hg))
           (neo-vcs--backends (cons (cons 'hg (plist-put (copy-sequence backend) :program hg))
                                   neo-vcs--backends))
           (process-environment (copy-sequence process-environment)))
      (cl-labels ((hg (&rest args) (apply #'neo-vcs-test-cli hg args))
                  (git (&rest args) (apply #'neo-vcs-test-cli git args))
                  (write-file-text (file text) (write-region text nil file nil 'silent)))
        (unwind-protect
            (progn
              (write-file-text hgrc "[ui]\nusername = Test <test@example.invalid>\n[subrepos]\ngit:allowed = true\n")
              (setenv "HGRCPATH" hgrc)
              (setenv "HGPLAIN" "1")
              (setenv "GIT_AUTHOR_NAME" "Neo VCS Test")
              (setenv "GIT_AUTHOR_EMAIL" "test@example.invalid")
              (setenv "GIT_COMMITTER_NAME" "Neo VCS Test")
              (setenv "GIT_COMMITTER_EMAIL" "test@example.invalid")
              (hg "init" remote)
              (hg "clone" remote repo)
              (git "init" "-b" "main" child)
              (let ((default-directory child))
                (git "remote" "add" "origin" origin)
                (git "commit" "--allow-empty" "-m" "Known origin revision")
                (git "update-ref" "refs/remotes/origin/main" "HEAD")
                (git "commit" "--allow-empty" "-m" "Unpushed revision"))
              (let ((default-directory repo))
                (write-file-text ".hgsub" (format "git-child = [git]%s\n" origin))
                (hg "add" ".hgsub")
                (hg "commit" "-m" "Record unpublished subrepository revision"))
              (let ((default-directory child))
                (git "checkout" "-b" "unrelated" "HEAD^"))
              (let* ((context (list :backend 'hg :root repo))
                     (failure (should-error (neo-vcs-test-request context 'push nil nil t)
                                            :type 'ert-test-failed)))
                (should (string-search "unrelated git branch checked out in subrepository"
                                       (error-message-string failure))))
              (let ((default-directory remote))
                (should (string-empty-p (hg "log" "-T" "{rev}\n")))))
          (when (file-in-directory-p sandbox temporary-file-directory)
            (delete-directory sandbox t)))))))

(provide 'check-vcs-hg)
