;;; check-image-preview.el --- Binary preview checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(load (expand-file-name "neo-git.el" (file-name-directory load-file-name)) nil t)

(defun neo-git-image-check--run (program &rest arguments)
  (with-temp-buffer
    (let ((coding-system-for-read 'utf-8-unix)
          (coding-system-for-write (if (eq system-type 'windows-nt)
                                       w32-system-coding-system 'utf-8-unix)))
      (unless (zerop (apply #'process-file program nil t nil arguments))
        (error "%s: %s" program (buffer-string)))
      (string-trim (buffer-string)))))

(defun neo-git-image-check--wait (source)
  (let ((deadline (+ (float-time) 20)))
    (while (and (buffer-local-value 'neo-git--diff-process source) (< (float-time) deadline))
      (accept-process-output nil 0.03))
    (should-not (buffer-local-value 'neo-git--diff-process source))))

(defun neo-git-image-check--width (preview)
  (with-current-buffer preview
    (let* ((pos (text-property-not-all (point-min) (point-max) 'display nil))
           (img (and pos (get-text-property pos 'display)))
           (data (plist-get (cdr img) :data)))
      (ert-info ((buffer-string))
        (should (stringp data))
        (should (equal (substring data 1 4) "PNG"))
        (when (display-graphic-p)
          (should (> (car (image-size img t)) 0)))
        (aref data 19)))))

(defun neo-git-image-check--clip (png)
  (let* ((db (sqlite-open (expand-file-name "source.sqlite")))
         (data (neo-git--image-bytes png))
         (coding-system-for-write 'no-conversion))
    (unwind-protect
        (progn
          (sqlite-execute db "CREATE TABLE CanvasPreview (ImageData BLOB)")
          (sqlite-execute db (format "INSERT INTO CanvasPreview VALUES (X'%s')"
                                     (mapconcat (lambda (b) (format "%02x" b)) data ""))))
      (sqlite-close db))
    (let* ((bytes (neo-git--image-bytes "source.sqlite"))
           (uint64 (lambda (n) (apply #'unibyte-string
                                      (cl-loop for shift from 56 downto 0 by 8
                                               collect (logand (ash n (- shift)) 255))))))
      (write-region (concat "CSFCHUNK" (funcall uint64 (+ 56 (length bytes))) (funcall uint64 24)
                            "CHNKSQLi" (funcall uint64 (length bytes)) bytes
                            "CHNKFoot" (funcall uint64 0)) nil "drawing.clip" nil 'silent))))

(ert-deftest neo-git-image-preview-formats-and-git-versions ()
  (skip-unless (and (executable-find "magick") (sqlite-available-p)))
  (let* ((root (file-name-as-directory (make-temp-file "neo-git-art-test-" t)))
         (default-directory root)
         (owner (generate-new-buffer " *image-status*"))
         (preview (generate-new-buffer " *image-preview*"))
         (name "絵 [1].PNG")
         (display-test (if (display-graphic-p) (symbol-function 'display-images-p)
                         (lambda (&rest _) t)))
         history)
    (unwind-protect
        (cl-letf (((symbol-function 'display-images-p) display-test))
          (neo-git-image-check--run "git" "init" "-q")
          (with-current-buffer owner
            (neo-git-mode)
            (setq neo-git-root root neo-git--preview-buffer preview))
          (cl-labels
              ((select-image (path kind)
                 (let* ((state (neo-git--parse-status
                                (neo-git-image-check--run "git" "status" "--porcelain=v2" "-z")))
                        (entry (seq-find (lambda (row) (and (equal (plist-get row :path) path)
                                                           (eq (plist-get row :kind) kind)))
                                         (plist-get state :entries))))
                   (should entry)
                   (with-current-buffer owner
                     (cl-letf (((symbol-function 'neo-git--entry-at-point) (lambda () entry)))
                       (neo-git--preview-selected))))
                 (neo-git-image-check--wait owner))
               (make-image-file (width path)
                 (neo-git-image-check--run "magick" "-size" (format "%dx4" width)
                                           "xc:red" "-type" "TrueColor" path))
               (commit (message)
                 (neo-git-image-check--run "git" "-c" "user.name=Test"
                                           "-c" "user.email=test@example.invalid"
                                           "-c" "commit.gpgsign=false" "commit" "-qm" message)))
            (make-image-file 3 name)
            (neo-git-image-check--run "git" "add" "--" name)
            (commit "first image")
            (make-image-file 5 name)
            (neo-git-image-check--run "git" "add" "--" name)
            (make-image-file 7 name)
            (select-image name 'staged)
            (should (= 5 (neo-git-image-check--width preview)))
            (select-image name 'unstaged)
            (should (= 7 (neo-git-image-check--width preview)))
            (let ((find-program (symbol-function 'executable-find)))
              (cl-letf (((symbol-function 'executable-find)
                         (lambda (program &rest args)
                           (unless (equal program "magick") (apply find-program program args)))))
                (select-image name 'unstaged)
                (should (= 7 (neo-git-image-check--width preview)))
                (with-current-buffer preview
                  (should (string-search "Pixel comparison requires ImageMagick" (buffer-string))))))
            ;; Moving away while conversion runs must only publish the latest row.
            (with-current-buffer owner
              (cl-letf (((symbol-function 'neo-git--entry-at-point)
                         (lambda () (list :path name :kind 'staged))))
                (neo-git--preview-selected)))
            (select-image name 'unstaged)
            (should (= 7 (neo-git-image-check--width preview)))
            (when (executable-find "git-lfs")
              (with-temp-buffer
                (should (eq 0 (process-file "git-lfs" (expand-file-name name) t nil "clean" "--" "art.png")))
                (write-region (point-min) (point-max) "art.png" nil 'silent))
              (select-image "art.png" 'untracked)
              (should (= 7 (neo-git-image-check--width preview))))
            (neo-git-image-check--clip name)
            (copy-file "drawing.clip" "alias.clpi")
            (dolist (path '("drawing.clip" "alias.clpi" "photo.psd" "poster.psb"))
              (when (member path '("photo.psd" "poster.psb")) (make-image-file 7 path))
              (select-image path 'untracked)
              (should (= 7 (neo-git-image-check--width preview))))
            (with-temp-file "invalid.clpi" (insert "HDMV0200"))
            (select-image "invalid.clpi" 'untracked)
            (with-current-buffer preview
              (should (string-match-p "not a CLIP STUDIO" (buffer-string)))
              (should-not (text-property-not-all (point-min) (point-max) 'display nil)))
            (delete-file name)
            (select-image name 'unstaged)
            (should (= 5 (neo-git-image-check--width preview)))
            (neo-git-image-check--run "git" "add" "-u")
            (select-image name 'staged)
            (should (= 3 (neo-git-image-check--width preview)))
            (commit "delete image")
            (let ((oid (neo-git-image-check--run "git" "rev-parse" "HEAD")))
              (with-temp-buffer
                (setq neo-git--browser-kind 'history neo-git-root root neo-git--diff-owner owner)
                (cl-letf (((symbol-function 'tabulated-list-get-id) (lambda () oid))
                          ((symbol-function 'pop-to-buffer) (lambda (b &rest _) (setq history b))))
                  (neo-git-history-image)))
              (neo-git-image-check--wait history)
              (should (= 3 (neo-git-image-check--width history))))))
      (dolist (buffer (list owner preview history)) (when (buffer-live-p buffer) (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest neo-git-image-diff-pixels-and-revisions ()
  (skip-unless (and (executable-find "magick") (sqlite-available-p)))
  (let* ((root (file-name-as-directory (make-temp-file "neo-git-image-diff-" t)))
         (default-directory root)
         (owner (generate-new-buffer " *image-diff-status*"))
         (preview (generate-new-buffer " *image-diff-preview*"))
         (history-list (generate-new-buffer " *image-diff-history-list*"))
         (layout (current-window-configuration))
         (image-path "絵 [1].png")
         (can-display (if (display-graphic-p) (symbol-function 'display-images-p)
                        (lambda (&rest _) t)))
         history)
    (unwind-protect
        (cl-letf (((symbol-function 'display-images-p) can-display))
          (neo-git-image-check--run "git" "init" "-q")
          (with-current-buffer owner
            (neo-git-mode)
            (setq neo-git-root root default-directory root neo-git--preview-buffer preview))
          (neo-git--layout owner history-list)
          (cl-labels
              ((commit (subject)
                 (neo-git-image-check--run "git" "-c" "user.name=Test" "-c" "user.email=test@example.invalid"
                                           "-c" "commit.gpgsign=false" "commit" "-qm" subject))
               (save-artwork ()
                 (neo-git-image-check--clip image-path)
                 (delete-file "source.sqlite")
                 (dolist (file '("art.psd" "art.psb"))
                   (neo-git-image-check--run "magick" image-path "-type" "TrueColor" "-depth" "8"
                                             "-compress" "none" file))
                 (neo-git-image-check--run "git" "add" "--" image-path "drawing.clip" "art.psd" "art.psb"))
               (status-diff (path kind)
                 (let* ((state (neo-git--parse-status
                                (neo-git-image-check--run "git" "status" "--porcelain=v2" "-z")))
                        (entry (seq-find (lambda (row) (and (equal path (plist-get row :path))
                                                           (eq kind (plist-get row :kind))))
                                         (plist-get state :entries))))
                   (should entry)
                   (with-current-buffer owner
                     (setq neo-git-state state neo-git-entries (plist-get state :entries))
                     (neo-git--render entry)
                     (forward-line -1)
                     (call-interactively (key-binding (kbd "j"))))
                   (neo-git-image-check--wait owner)
                   (let ((left (selected-window))
                         (right (buffer-local-value 'neo-git--preview-window owner)))
                     (should (eq (window-buffer left) owner))
                     (should (eq (window-buffer right) preview))
                     (should (>= (car (window-edges right)) (nth 2 (window-edges left)))))))
               (history-diff (path)
                 (let ((oid (neo-git-image-check--run "git" "rev-parse" "HEAD")))
                   (with-temp-buffer
                     (setq neo-git--browser-kind 'history neo-git-root root neo-git--diff-owner owner)
                     (cl-letf (((symbol-function 'tabulated-list-get-id) (lambda () oid))
                               ((symbol-function 'completing-read) (lambda (&rest _) path)))
                       (save-selected-window
                         (call-interactively (lookup-key neo-git-browser-mode-map (kbd "i")))
                         (setq history (window-buffer (selected-window))))))
                   (neo-git-image-check--wait history)))
               (check-text (buffer expected)
                 (with-current-buffer buffer
                   (ert-info ((buffer-string))
                     (should (string-search expected (buffer-string)))))))
            (neo-git-image-check--run "magick" "-size" "4x2" "xc:red" (concat "PNG24:" image-path))
            (status-diff image-path 'untracked)
            (check-text preview "Added image")
            (save-artwork)
            (status-diff image-path 'staged)
            (check-text preview "Added image")
            (commit "initial artwork")
            (history-diff image-path)
            (check-text history "Added image")
            (neo-git-image-check--run "magick" "-size" "4x2" "xc:red" "-fill" "blue"
                                      "-draw" "point 0,0" (concat "PNG24:" image-path))
            (save-artwork)
            (neo-git-image-check--run "magick" image-path "-alpha" "set" "-channel" "A" "-evaluate"
                                      "set" "50%" "+channel" "-background" "none" "-gravity" "NorthWest"
                                      "-extent" "5x2" image-path)
            (dolist (file (list image-path "drawing.clip" "art.psd" "art.psb"))
              (status-diff file 'staged)
              (check-text preview "1 changed pixel  |  4x2 -> 4x2")
              (should (= 4 (neo-git-image-check--width preview))))
            ;; Check the mask itself, including an unchanged neighbor.
            (with-current-buffer preview
              (let* ((pos (text-property-not-all (point-min) (point-max) 'display nil))
                     (data (plist-get (cdr (get-text-property pos 'display)) :data))
                     (coding-system-for-write 'no-conversion))
                (write-region data nil (expand-file-name "mask.png" root) nil 'silent)))
            (should (equal "FF375F 252932"
                           (upcase (neo-git-image-check--run "magick" "mask.png" "-format"
                                                            "%[hex:p{0,0}] %[hex:p{1,1}]" "info:"))))
            (status-diff image-path 'unstaged)
            (check-text preview "8 changed pixels  |  4x2 -> 5x2")
            (with-current-buffer preview (call-interactively (key-binding (kbd "I"))))
            (neo-git-image-check--wait owner)
            (should (= 5 (neo-git-image-check--width preview)))
            (with-current-buffer preview (should-not (string-search "changed pixel" (buffer-string))))
            (commit "change one pixel")
            (history-diff image-path)
            (check-text history "1 changed pixel")
            (neo-git-image-check--run "git" "mv" "--" image-path "renamed.png")
            (status-diff "renamed.png" 'staged)
            (check-text preview "0 changed pixels")
            (status-diff "renamed.png" 'unstaged)
            (check-text preview "8 changed pixels")
            (commit "rename artwork")
            (history-diff "renamed.png")
            (check-text history "0 changed pixels")
            (dotimes (_ 2)
              (with-current-buffer history (call-interactively (key-binding (kbd "I"))))
              (neo-git-image-check--wait history))
            (check-text history "0 changed pixels")
            (delete-file "renamed.png")
            (status-diff "renamed.png" 'unstaged)
            (check-text preview "Deleted image")
            (neo-git-image-check--run "git" "add" "-u")
            (commit "delete artwork")
            (history-diff "renamed.png")
            (check-text history "Deleted image")
            ;; The only changed pixel lies beyond the thumbnail width.
            (neo-git-image-check--run "magick" "-size" "2400x4" "xc:red" "wide.png")
            (neo-git-image-check--run "git" "add" "--" "wide.png")
            (commit "wide artwork")
            (neo-git-image-check--run "magick" "wide.png" "-fill" "blue" "-draw" "point 2399,3" "wide.png")
            (status-diff "wide.png" 'unstaged)
            (check-text preview "1 changed pixel  |  2400x4 -> 2400x4")
            ;; Materialize two unmerged index stages without invoking a merge driver.
            (let ((ours (neo-git-image-check--run "git" "rev-parse" "HEAD:wide.png"))
                  (theirs (neo-git-image-check--run "git" "hash-object" "-w" "wide.png")))
              (let ((coding-system-for-write 'utf-8-unix))
                (with-temp-file "stages"
                  (insert "100644 " ours " 2\tconflict.png\n100644 " theirs " 3\tconflict.png\n"
                          "100644 " ours " 1\tremoved.png\n")))
              (should (eq 0 (process-file "git" (expand-file-name "stages") nil nil "update-index" "--index-info")))
              (status-diff "conflict.png" 'conflict)
              (check-text preview "1 changed pixel")
              (check-text preview "[ours]")
              (check-text preview "[theirs]")
              (status-diff "removed.png" 'conflict)
              (check-text preview "Deleted image")
              (check-text preview "[base]"))))
      (set-window-configuration layout)
      (dolist (buffer (list owner preview history-list history)) (when (buffer-live-p buffer) (kill-buffer buffer)))
      (delete-directory root t))))
