;;; check-vcs-svn.el --- Subversion backend checks -*- lexical-binding: t; coding: utf-8; -*-
(require 'check-vcs-test-helper)
(require 'url-util)

(defconst neo-vcs-svn-test-context
  (list :backend 'svn :root (file-name-as-directory temporary-file-directory)))

(ert-deftest neo-vcs-svn-status-reads-property-tree-conflict-and-move ()
  (let* ((request (neo-vcs--request neo-vcs-svn-test-context 'status))
         (fixture "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<status><target path=\".\">
<entry path=\".\"><wc-status item=\"normal\" revision=\"0\" props=\"modified\"/></entry>
<entry path=\"prop.txt\"><wc-status item=\"normal\" revision=\"13\" props=\"conflicted\"/></entry>
<entry path=\"gone.txt\"><wc-status item=\"missing\" tree-conflicted=\"true\" revision=\"4\" props=\"none\"/></entry>
<entry path=\"old &amp; name.txt\"><wc-status item=\"deleted\" revision=\"4\" props=\"normal\" moved-to=\"-名前 [a]@42.txt\"/></entry>
<entry path=\"-名前 [a]@42.txt\"><wc-status item=\"added\" props=\"normal\" copied=\"true\" moved-from=\"old &amp; name.txt\"/></entry>
<entry path=\"external\"><wc-status item=\"external\" props=\"none\"/></entry>
</target><changelist name=\"release\">
<entry path=\"line&#10;break\"><wc-status item=\"modified\" props=\"normal\" revision=\"1\"/></entry>
</changelist></status>")
         (parse (plist-get request :parse))
         (entries (plist-get (funcall parse (list fixture)) :entries)))
    (should (plist-get (car entries) :root-entry))
    (should (equal (mapcar (lambda (entry)
                            (list (plist-get entry :path) (plist-get entry :status)
                                  (plist-get entry :old-path)))
                          entries)
                   '(("." modified nil) ("prop.txt" conflict nil) ("gone.txt" conflict nil)
                     ("old & name.txt" deleted nil) ("-名前 [a]@42.txt" added "old & name.txt")
                     ("line\nbreak" modified nil))))
    (should-error (funcall parse '("<log/>")))
    (should-error (funcall parse '("<status><target path=\".\"><entry path=\"../escape\"><wc-status item=\"modified\" props=\"none\"/></entry></target></status>")))))

(ert-deftest neo-vcs-svn-history-allows-revision-zero-and-missing-revprops ()
  (let* ((request (neo-vcs--request neo-vcs-svn-test-context 'history))
         (parse (plist-get request :parse)))
    (should (member "HEAD:0" (plist-get (car (plist-get request :commands)) :args)))
    (should-not (funcall parse '("<?xml version=\"1.0\"?><log/>")))
    (should (equal (funcall parse '("<log><logentry revision=\"42\"><msg>変更 &amp; details&#10;Next line</msg></logentry></log>"))
                   '((:id "42" :short "r42" :author "" :date "" :subject "変更 & details"))))))

(ert-deftest neo-vcs-svn-file-operations-are-nonrecursive-literal-and-explicit ()
  (let* ((entry '(:path "-名前 [a]@42.txt"))
         (target (list entry)))
    (dolist (action '(add delete revert commit resolve))
      (should-error (neo-vcs--request neo-vcs-svn-test-context action nil '(:message "selected"))
                    :type 'user-error)
      (should (equal (last (plist-get (car (last (plist-get
                                            (neo-vcs--request neo-vcs-svn-test-context action target
                                                              '(:message "selected"))
                                            :commands)))
                                      :args)
                           2)
                     '("--" "./-名前 [a]@42.txt@"))))
    (let ((args (plist-get (car (plist-get (neo-vcs--request neo-vcs-svn-test-context 'diff entry)
                                         :commands))
                           :args)))
      (should (member "empty" args))
      (should (equal (last args 2) '("--" "./-名前 [a]@42.txt"))))))

(ert-deftest neo-vcs-svn-real-cli-workflow ()
  (let ((svn (or (getenv "NEO_VCS_TEST_SVN") (executable-find "svn")))
        (svnadmin (or (getenv "NEO_VCS_TEST_SVNADMIN") (executable-find "svnadmin"))))
    (skip-unless (and svn svnadmin (file-executable-p svn) (file-executable-p svnadmin)))
    (let* ((sandbox (make-temp-file "neo-vcs-svn-" t))
           (repo (expand-file-name "repository" sandbox))
           (url (url-encode-url (concat (if (eq system-type 'windows-nt) "file:///" "file://") repo)))
           (config (expand-file-name "config" sandbox))
           (empty-copy (file-name-as-directory (expand-file-name "empty" sandbox)))
           (wc (file-name-as-directory (expand-file-name "checkout" sandbox)))
           (second (file-name-as-directory (expand-file-name "second" sandbox)))
           (backend (neo-vcs--backend 'svn))
           (neo-vcs--backends (cons (cons 'svn (plist-put (copy-sequence backend) :program svn))
                                   neo-vcs--backends))
           (name "-名前 [glob]@42.txt")
           (sibling "unselected.txt")
           (moved "-移動 [glob]@")
           (chosen (list (list :path name)))
           (other (list (list :path sibling)))
           (moved-target (list (list :path moved))))
      (cl-labels ((cli (&rest args)
                    (apply #'neo-vcs-test-cli svn "--non-interactive" "--config-dir" config args))
                  (context (root)
                    (neo-vcs-test-request (list :backend 'svn :root root :svn-config-dir config) 'root))
                  (entry (context path)
                    (cl-find path (plist-get (neo-vcs-test-request context 'status) :entries)
                             :key (lambda (item) (plist-get item :path)) :test #'equal)))
        (unwind-protect
            (progn
              (neo-vcs-test-cli svnadmin "create" repo)
              (cli "checkout" url empty-copy)
              (should-not (neo-vcs-test-request (context empty-copy) 'history))
              (let ((trunk (concat url "/trunk"))
                    (branches (concat url "/branches")))
                (cli "mkdir" trunk branches "--message" "Project directories")
                (cli "checkout" trunk wc)
                (let ((context (context wc)))
                  (should (file-equal-p (plist-get context :root) wc))
                  (let ((coding-system-for-write 'utf-8-unix))
                    (write-region "元の内容\n" nil (expand-file-name name wc) nil 'silent))
                  (write-region "other\n" nil (expand-file-name sibling wc) nil 'silent)
                  (neo-vcs-test-request context 'add (append chosen other) nil t)
                  (let ((default-directory wc))
                    (cli "propset" "svn:ignore" "local-cache" ".")
                    (cli "propset" "svn:mime-type" "text/plain" "--" (concat "./" name "@")))
                  (should (string-search "Added: svn:ignore"
                                         (neo-vcs-test-request context 'diff (entry context "."))))
                  (neo-vcs-test-request context 'commit chosen '(:message "First selected file\n\nDetails") t)
                  (should (eq (plist-get (entry context sibling) :status) 'added))
                  (should (eq (plist-get (entry context ".") :status) 'modified))
                  (let ((revision (car (neo-vcs-test-request context 'history))))
                    (should (equal (plist-get revision :subject) "First selected file"))
                    (let ((patch (neo-vcs-test-request context 'show revision)))
                      (should (string-search (concat "Index: " name) patch))
                      (should (string-search "+元の内容" patch))))
                  (neo-vcs-test-open context)
                  (let ((default-directory wc))
                    (cli "move" "--" (concat "./" name "@") (concat "./" moved)))
                  (should (equal (plist-get (entry context moved) :old-path) name))
                  (neo-vcs-test-request context 'commit (append chosen moved-target)
                                        '(:message "Explicit move pair") t)
                  (let ((default-directory wc))
                    (cli "revert" "--depth" "empty" "."))
                  (neo-vcs-test-request context 'revert other nil t)
                  (should (eq (plist-get (entry context sibling) :status) 'untracked))
                  (cli "copy" trunk (concat branches "/feature") "--message" "Feature branch")
                  (neo-vcs-test-request context 'switch nil '(:url "^/branches/feature") t)
                  (cli "checkout" (concat branches "/feature") second)
                  (write-region "remote edit\n" nil (expand-file-name moved second) nil 'silent)
                  (neo-vcs-test-request (context second) 'commit moved-target '(:message "Remote edit") t)
                  (let ((coding-system-for-write 'utf-8-unix))
                    (write-region "++ 新規\n" nil (expand-file-name moved wc) nil 'silent))
                  (let ((default-directory wc))
                    (cli "propset" "test:property" "value" "--" (concat "./" moved "@")))
                  (let ((patch (neo-vcs-test-request context 'diff (car moved-target))))
                    (should (string-search (concat "Index: " moved) patch))
                    (should (string-search (concat "Property changes on: " moved) patch))
                    (should (string-match-p "\n[+][+][+] 新規\r?\n" patch)))
                  (neo-vcs-test-request context 'update nil nil t)
                  (should (eq (plist-get (entry context moved) :status) 'conflict))
                  (write-region "resolved edit\n" nil (expand-file-name moved wc) nil 'silent)
                  (neo-vcs-test-request context 'resolve moved-target nil t)
                  (should (eq (plist-get (entry context moved) :status) 'modified))
                  (neo-vcs-test-request context 'revert moved-target nil t)
                  (neo-vcs-test-request context 'delete moved-target nil t)
                  (should (eq (plist-get (entry context moved) :status) 'deleted))
                  (should (string-search "-remote edit" (neo-vcs-test-request context 'diff (car moved-target))))
                  (let ((folder '((:path "folder")))
                        (child '((:path "folder/child.txt")))
                        (default-directory wc))
                    (cli "mkdir" "folder")
                    (write-region "child content\n" nil (expand-file-name "folder/child.txt" wc) nil 'silent)
                    (neo-vcs-test-request context 'add child nil t)
                    (neo-vcs-test-request context 'commit (append folder child) '(:message "Folder fixture") t)
                    (should-error (neo-vcs-test-request context 'delete folder nil t) :type 'ert-test-failed)
                    (should (file-exists-p (expand-file-name "folder/child.txt" wc)))
                    (cli "delete" "folder")
                    (should-error (neo-vcs-test-request context 'commit folder '(:message "Unscoped deletion") t)
                                  :type 'ert-test-failed)
                    (should (string-search "child content"
                                           (cli "cat" (concat branches "/feature/folder/child.txt"))))))))
          (when (file-in-directory-p sandbox temporary-file-directory)
            (delete-directory sandbox t)))))))

(provide 'check-vcs-svn)
